{
  "name": "klair-daemon",
  "version": "0.1.0",
  "description": "File watcher daemon for KLAIR — captures edits with git diffs",
  "type": "module",
  "bin": {
    "klair-daemon": "./bin/klair-daemon.js"
  },
  "main": "./src/daemon.js",
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "start": "node ./bin/klair-daemon.js start"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "express": "^5.1.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  }
}
